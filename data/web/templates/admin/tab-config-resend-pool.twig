<div class="tab-pane fade" id="tab-config-resend-pool" role="tabpanel" aria-labelledby="tab-config-resend-pool">
  <div class="card mb-4">
    <div class="card-header d-flex fs-5">
      <button class="btn d-md-none flex-grow-1 text-start" data-bs-target="#collapse-tab-resend-pool" data-bs-toggle="collapse" aria-controls="collapse-tab-resend-pool">
        Resend 号池
      </button>
      <span class="d-none d-md-block">Resend 号池（多账号发信）</span>
    </div>
    <div id="collapse-tab-resend-pool" class="card-body collapse show" data-bs-parent="#admin-content">

      <div class="alert alert-info">
        <b>用途</b>：Resend 免费版每个账号只能绑定 3 个域名。把多个账号加入号池，
        系统会自动把域名分配到大容量未满的账号，并把每个账号自动配置成 mailcow 的中继主机。
        <br><b>注意</b>：添加的 API Key 必须是 <b>Full access</b> 权限。
        Sending access 权限的 Key 无法管理域名，会被拒绝。
      </div>

      <!-- 顶部操作栏 -->
      <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <button class="btn btn-sm btn-secondary" id="rp_refresh"><i class="bi bi-arrow-clockwise"></i> 刷新</button>
        <button class="btn btn-sm btn-secondary" id="rp_sync"><i class="bi bi-cloud-download"></i> 同步验证状态</button>
        <button class="btn btn-sm btn-primary" id="rp_auto_assign"><i class="bi bi-magic"></i> 自动分配全部域名</button>
        <div class="ms-auto d-flex align-items-center gap-2">
          <label class="mb-0 text-muted">每账号域名上限</label>
          <input type="number" min="1" max="1000" class="form-control form-control-sm" id="rp_limit" style="width:6rem">
          <button class="btn btn-sm btn-outline-secondary" id="rp_save_limit">保存</button>
        </div>
      </div>

      <!-- 号池账号 -->
      <legend>号池账号</legend><hr />
      <div class="table-responsive">
        <table class="table table-striped" id="rp_accounts_table">
          <thead>
            <tr>
              <th style="width:16%">标签</th>
              <th style="width:22%">API Key</th>
              <th style="width:12%">已用 / 上限</th>
              <th style="width:10%">状态</th>
              <th style="width:24%">最近校验</th>
              <th style="width:16%">操作</th>
            </tr>
          </thead>
          <tbody id="rp_accounts_body">
            <tr><td colspan="6" class="text-muted">加载中…</td></tr>
          </tbody>
        </table>
      </div>

      <!-- 添加账号 -->
      <legend>添加账号</legend><hr />
      <div class="row">
        <div class="col-md-8">
          <div class="mb-2">
            <label for="rp_new_label">标签（可选）</label>
            <input class="form-control" id="rp_new_label" placeholder="例如：账号 A、主号">
          </div>
          <div class="mb-2">
            <label for="rp_new_key">Resend API Key（需 Full access 权限）</label>
            <input class="form-control" id="rp_new_key" type="password" placeholder="re_xxxxxxxxxxxxxxxx">
          </div>
          <div class="mb-3">
            <button class="btn btn-sm btn-outline-secondary" id="rp_test_key">测试 Key</button>
            <button class="btn btn-sm btn-success" id="rp_add_account"><i class="bi bi-plus-lg"></i> 添加</button>
          </div>
          <div id="rp_key_result" class="mb-3"></div>
        </div>
      </div>

      <!-- Cloudflare Token（可选，用于自动写 DNS） -->
      <legend>Cloudflare Token（可选）</legend><hr />
      <p class="text-muted mb-2">
        配置后，绑定域名时会<b>自动把 Resend 需要的 DNS 记录写入 Cloudflare</b>，无需手工配置。
        需要 Token 具备 <code>Zone → DNS → Edit</code> 权限。
      </p>
      <div class="row">
        <div class="col-md-8">
          <div class="input-group mb-3">
            <input class="form-control" id="rp_cf_token" type="password" placeholder="Cloudflare API Token">
            <button class="btn btn-sm btn-outline-secondary" id="rp_save_cf">保存</button>
            <button class="btn btn-sm btn-outline-danger" id="rp_clear_cf">清除</button>
          </div>
          <div id="rp_cf_state" class="text-muted small mb-3"></div>
        </div>
      </div>

      <!-- 域名绑定 -->
      <legend>域名绑定</legend><hr />
      <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
        <div class="input-group" style="max-width:32rem">
          <input class="form-control" id="rp_assign_domain" placeholder="要绑定的域名，如 example.com">
          <select class="form-select" id="rp_assign_account" style="max-width:14rem"></select>
          <button class="btn btn-sm btn-success" id="rp_assign_btn">绑定</button>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-striped" id="rp_domains_table">
          <thead>
            <tr>
              <th style="width:26%">域名</th>
              <th style="width:16%">所属账号</th>
              <th style="width:14%">验证状态</th>
              <th style="width:26%">DNS 记录</th>
              <th style="width:18%">操作</th>
            </tr>
          </thead>
          <tbody id="rp_domains_body">
            <tr><td colspan="5" class="text-muted">加载中…</td></tr>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</div>
