{% extends 'base.twig' %}
{#
  ⚠️ 每个 tbody 必须带**占位行**，不能留空。
  mailcow 的 footer.js 里有一条全局规则：
      $('tbody').filter(function(){ return $(this).children().length < 1; }).remove();
  它在解析阶段执行，会把页面上所有**空的 tbody 整个删掉**。
  本页是「服务端内联数据 + JS 填表」，tbody 一旦留空就会被删，
  JS 再 .html() 就找不到容器了 —— 表现为统计卡有数字、但所有列表全空。
  占位行让 tbody 非空从而不被删；JS 渲染时会把占位行整体替换掉。
#}

{% block content %}
{# csrf_token 必须注入：本页继承 base.twig 而非 admin.twig #}
<script>var csrf_token = '{{ csrf_token }}';</script>
{# 首屏数据由服务端内联，打开即有内容，不闪「加载中」，也不多一次 AJAX 往返 #}
<script>window.__ov_initial = {{ ov_initial|raw }};</script>

<div class="container-fluid">

  <!-- ========== 顶部指标条 ========== -->
  <div class="row g-2 mb-3">
    <div class="col-6 col-lg-2">
      <div class="card h-100"><div class="card-body py-2">
        <div class="text-muted small">域名</div>
        <div class="fs-4" id="ov_stat_domains">—</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-2">
      <div class="card h-100"><div class="card-body py-2">
        <div class="text-muted small">邮箱账号</div>
        <div class="fs-4" id="ov_stat_mailboxes">—</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-2">
      <div class="card h-100"><div class="card-body py-2">
        <div class="text-muted small">邮件总数</div>
        <div class="fs-4" id="ov_stat_msg">—</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-2">
      <div class="card h-100"><div class="card-body py-2">
        <div class="text-muted small">今日新增邮件</div>
        <div class="fs-4" id="ov_stat_new">—</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-2">
      <div class="card h-100"><div class="card-body py-2">
        <div class="text-muted small">异常域名</div>
        <div class="fs-4" id="ov_stat_abnormal">—</div>
      </div></div>
    </div>
    <div class="col-6 col-lg-2">
      <div class="card h-100"><div class="card-body py-2">
        <div class="text-muted small">今日已发（养号）</div>
        <div class="fs-4" id="ov_stat_today">—</div>
      </div></div>
    </div>
  </div>

  <div id="ov_notice"></div>

  <!-- ========== 域名总览 ========== -->
  <div class="card mb-3">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
      <span class="fs-5">域名总览</span>
      <span class="text-muted small">收信 MX · 认证 · 注册时长 · 邮件 · 中继 · 养号</span>
      <div class="ms-auto d-flex gap-2">
        <button class="btn btn-sm btn-secondary" id="ov_refresh">刷新</button>
        <button class="btn btn-sm btn-primary" id="ov_check_all">一键体检全部</button>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table id="ov_tbl_domains" class="table table-sm table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th style="width:17%">域名</th>
              <th style="width:9%">注册时长</th>
              <th style="width:13%">收信 MX</th>
              <th style="width:15%">认证</th>
              <th style="width:9%">邮件</th>
              <th style="width:11%">出站中继</th>
              <th style="width:11%">养号</th>
              <th style="width:15%">操作</th>
            </tr>
          </thead>
          <tbody id="ov_domains_body">
              <tr><td colspan="8" class="text-center text-muted py-3">正在加载域名…</td></tr>
            </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ========== 邮箱账号 ========== -->
  <div class="card mb-3">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
      <span class="fs-5">邮箱账号</span>
      <span class="text-muted small">
        密码为 bcrypt 单向哈希，<b>无法显示明文</b>；可用「重置密码」生成新密码（只显示一次）
      </span>
      <div class="ms-auto">
        <input type="text" class="form-control form-control-sm" id="ov_mbox_filter"
               placeholder="筛选邮箱…" style="width:14rem">
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive" style="max-height:28rem;overflow:auto">
        <table id="ov_tbl_mbox" class="table table-sm table-hover mb-0 align-middle">
          <thead class="table-light" style="position:sticky;top:0">
            <tr>
              <th style="width:24%">邮箱</th>
              <th style="width:13%">所属域</th>
              <th style="width:7%">状态</th>
              <th style="width:11%">出站账号</th>
              <th style="width:10%">邮件数</th>
              <th style="width:7%">今日新增</th>
              <th style="width:8%">配额</th>
              <th style="width:20%">操作</th>
            </tr>
          </thead>
          <tbody id="ov_mbox_body">
              <tr><td colspan="8" class="text-center text-muted py-3">正在加载邮箱…</td></tr>
            </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ========== 中继号池（Resend）+ Cloudflare ========== -->
  <div class="card mb-3" id="ov_pool_card">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
      <span class="fs-5">中继号池（Resend）+ Cloudflare</span>
      <span class="text-muted small">多账号负载均衡 · 域名绑定 · 容量与额度</span>
      <div class="ms-auto d-flex gap-2">
        <button class="btn btn-sm btn-secondary" id="ov_pool_sync">同步状态</button>
        <button class="btn btn-sm btn-outline-secondary" id="ov_pool_reveal">显示/隐藏 Key</button>
      </div>
    </div>
    <div class="card-body">

      <!-- 汇总 -->
      <div class="row g-2 mb-3">
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">启用账号</div><div class="fs-5" id="ov_pool_accounts">—</div></div></div>
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">已绑域名 / 总容量</div>
          <div class="fs-5"><span id="ov_pool_used">—</span> / <span id="ov_pool_capacity">—</span></div></div></div>
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">剩余可绑</div><div class="fs-5" id="ov_pool_left">—</div></div></div>
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">日额度合计</div><div class="fs-5" id="ov_pool_quota">—</div></div></div>
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">单账号域上限</div><div class="fs-5" id="ov_pool_limit">—</div>
            <div class="d-flex gap-1 mt-1">
              <input type="number" class="form-control form-control-sm" id="ov_pool_limit_in" min="1" max="1000" style="width:5rem">
              <button class="btn btn-sm btn-outline-primary" id="ov_pool_limit_set">改</button>
            </div></div></div>
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">Cloudflare Token</div>
          <div class="small" id="ov_cf_state">—</div>
          <div class="d-flex gap-1 mt-1">
            <input type="text" class="form-control form-control-sm" id="ov_cf_token" placeholder="cfat_…" style="width:100%">
            <button class="btn btn-sm btn-outline-primary" id="ov_cf_save">存</button>
          </div></div></div>
      </div>

      <!-- 账号表 -->
      <div class="table-responsive mb-3">
        <table id="ov_tbl_pool" class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th style="width:5%">ID</th><th style="width:16%">标签</th><th style="width:16%">API Key</th>
                <th style="width:8%">状态</th><th style="width:11%">已绑/上限</th><th style="width:9%">日配额</th>
                <th style="width:19%">最近校验</th><th style="width:16%">操作</th></tr>
          </thead>
          <tbody id="ov_pool_body">
              <tr><td colspan="8" class="text-center text-muted py-3">正在加载中继账号…</td></tr>
            </tbody>
        </table>
      </div>

      <!-- 新增账号 -->
      <div class="row g-2 mb-4">
        <div class="col-md-3"><input type="text" class="form-control form-control-sm" id="ov_acc_label"
          placeholder="标签（如 Resend-账号2）"></div>
        <div class="col-md-6"><input type="text" class="form-control form-control-sm" id="ov_acc_key"
          placeholder="re_ 开头的 API Key（需 Full access 权限）"></div>
        <div class="col-md-3 d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" id="ov_acc_check">先测 Key</button>
          <button class="btn btn-sm btn-primary" id="ov_acc_add">添加账号</button>
        </div>
      </div>

      <!-- 域名绑定 -->
      <div class="d-flex align-items-center gap-2 mb-2">
        <span class="fs-6">域名绑定</span>
        <span class="text-muted small">把域名绑到某个账号后，该域出站邮件即走该账号</span>
        <div class="ms-auto d-flex gap-2">
          <select class="form-select form-select-sm" id="ov_bind_domain" style="width:16rem"></select>
          <select class="form-select form-select-sm" id="ov_bind_account" style="width:14rem"></select>
          <button class="btn btn-sm btn-primary" id="ov_bind">绑定</button>
          <button class="btn btn-sm btn-outline-primary" id="ov_auto_assign">一键自动分配</button>
        </div>
      </div>
      <div class="table-responsive">
        <table id="ov_tbl_bind" class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr><th style="width:26%">域名</th><th style="width:20%">所属账号</th><th style="width:14%">Resend 状态</th>
                <th style="width:20%">验证通过时间</th><th style="width:20%">操作</th></tr>
          </thead>
          <tbody id="ov_bind_body">
              <tr><td colspan="5" class="text-center text-muted py-3">正在加载域名绑定…</td></tr>
            </tbody>
        </table>
      </div>

    </div>
  </div>

  <!-- ========== 养号（Warmup） ========== -->
  <div class="card mb-3" id="ov_warmup_card">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
      <span class="fs-5">养号（Warmup）</span>
      <span class="text-muted small" id="ov_wu_rule">—</span>
      <div class="ms-auto d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" id="ov_wu_check_deliv">核对投递（进箱/垃圾箱）</button>
        <button class="btn btn-sm btn-outline-secondary" id="ov_wu_interact">执行互动</button>
        <button class="btn btn-sm btn-secondary" id="ov_wu_refresh">刷新</button>
        <button class="btn btn-sm btn-warning" id="ov_wu_run">立即执行一次</button>
      </div>
    </div>
    <div class="card-body">

      <div class="row g-2 mb-2">
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">今日已发 / 全局上限</div>
          <div class="fs-5"><span id="ov_wu_today">—</span> / <span id="ov_wu_cap">—</span></div></div></div>
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">累计成功 / 失败</div>
          <div class="fs-5"><span id="ov_wu_sent">—</span> / <span id="ov_wu_fail">—</span></div></div></div>
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">进箱率（30 天）</div>
          <div class="fs-5" id="ov_wu_ibox_rate">—</div>
          <div><small class="text-muted" id="ov_wu_ibox_sub">—</small></div></div></div>
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">垃圾箱率（30 天）</div>
          <div class="fs-5" id="ov_wu_spam_rate">—</div>
          <div><small class="text-muted" id="ov_wu_spam_sub">—</small></div></div></div>
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">今日进箱 / 垃圾箱</div>
          <div class="fs-5" id="ov_wu_today_split">—</div>
          <div><small class="text-muted" id="ov_wu_today_rate">—</small></div></div></div>
        <div class="col-6 col-lg-2"><div class="border rounded p-2">
          <div class="text-muted small">已回复 / 已救援</div>
          <div class="fs-5"><span id="ov_wu_replied">—</span> / <span id="ov_wu_rescued">—</span></div>
          <div><small class="text-muted" id="ov_wu_box_state">—</small></div></div></div>
      </div>

      <div class="alert alert-secondary py-1 px-2 small mb-3" id="ov_wu_howto"></div>

      <!-- 计划表 -->
      <div class="table-responsive mb-3">
        <table class="table table-sm table-hover align-middle mb-0" id="ov_tbl_wuplan">
          <thead class="table-light">
            <tr><th style="width:17%">发件邮箱</th><th style="width:8%">进度</th>
                <th style="width:13%">今日配额（可改）</th><th style="width:8%">今日已发</th>
                <th style="width:13%">下一封</th><th style="width:9%">累计</th>
                <th style="width:13%">状态</th><th style="width:19%">操作</th></tr>
          </thead>
          <tbody id="ov_wu_plan_body">
              <tr><td colspan="8" class="text-center text-muted py-3">正在加载养号计划…</td></tr>
            </tbody>
        </table>
      </div>

      <!-- 新增计划 -->
      <div class="row g-2 mb-4 align-items-end">
        <div class="col-md-3">
          <label class="form-label mb-0 small">发件邮箱（从邮箱账号中选择）</label>
          <select class="form-select form-select-sm" id="ov_wu_sender"></select>
        </div>
        <div class="col-6 col-md-1"><label class="form-label mb-0 small">起量</label>
          <input type="number" class="form-control form-control-sm" id="ov_wu_start" value="2" min="1" max="50"></div>
        <div class="col-6 col-md-1"><label class="form-label mb-0 small">日增</label>
          <input type="number" class="form-control form-control-sm" id="ov_wu_step" value="1" min="0" max="20"></div>
        <div class="col-6 col-md-1"><label class="form-label mb-0 small">上限</label>
          <input type="number" class="form-control form-control-sm" id="ov_wu_max" value="20" min="1" max="200"></div>
        <div class="col-6 col-md-1"><label class="form-label mb-0 small">天数</label>
          <input type="number" class="form-control form-control-sm" id="ov_wu_days" value="30" min="1" max="365"></div>
        <div class="col-md-5">
          <button class="btn btn-sm btn-primary" id="ov_wu_add_plan">添加养号计划</button>
          <button class="btn btn-sm btn-outline-primary" id="ov_wu_add_all">一键为全部未养号的域创建计划</button>
        </div>
      </div>

      <!-- 收件人账号（带 IMAP/SMTP 凭据，可真实核对进箱与互动） -->
      <div class="d-flex align-items-center gap-2 mb-2">
        <span class="fs-6">收件人账号</span>
        <span class="text-muted small">
          填写 Google <b>应用专用密码</b> 后，可真实核对邮件进了收件箱还是垃圾箱，并代替对方互动
        </span>
        <div class="ms-auto">
          <button class="btn btn-sm btn-link p-0" id="ov_wu_gp_help" type="button">怎么获取应用专用密码？</button>
        </div>
      </div>
      <div class="row g-2 mb-2 align-items-end">
        <div class="col-md-3"><label class="form-label mb-0 small">收件邮箱</label>
          <input type="text" class="form-control form-control-sm" id="ov_wu_rc_email" placeholder="someone@gmail.com"></div>
        <div class="col-md-2"><label class="form-label mb-0 small">备注</label>
          <input type="text" class="form-control form-control-sm" id="ov_wu_rc_label" placeholder="可选"></div>
        <div class="col-md-3"><label class="form-label mb-0 small">应用专用密码</label>
          <input type="password" class="form-control form-control-sm" id="ov_wu_rc_secret" placeholder="16 位，如 abcd efgh ijkl mnop" autocomplete="new-password"></div>
        <div class="col-md-2">
          <div class="form-check"><input class="form-check-input" type="checkbox" id="ov_wu_rc_autoreply">
            <label class="form-check-label small" for="ov_wu_rc_autoreply">代它自动回复</label></div>
          <div class="form-check"><input class="form-check-input" type="checkbox" id="ov_wu_rc_rescue">
            <label class="form-check-label small" for="ov_wu_rc_rescue">垃圾箱救援</label></div>
        </div>
        <div class="col-md-2">
          <button class="btn btn-sm btn-primary w-100" id="ov_wu_rc_add">添加并验证</button>
        </div>
      </div>
      <div class="table-responsive mb-4">
        <table class="table table-sm align-middle mb-0" id="ov_tbl_wurc">
          <thead class="table-light"><tr>
            <th style="width:20%">收件账号</th><th style="width:9%">凭据</th>
            <th style="width:20%">IMAP 验证</th><th style="width:14%">进箱/垃圾箱/回复</th>
            <th style="width:14%">互动</th><th style="width:23%">操作</th></tr></thead>
          <tbody id="ov_wu_rc_body">
              <tr><td colspan="6" class="text-center text-muted py-3">正在加载收件人…</td></tr>
            </tbody>
        </table>
      </div>

      <!-- 逐封明细 -->
      <div class="d-flex align-items-center gap-2 mb-2">
        <span class="fs-6">逐封明细</span>
        <span class="text-muted small">每一封发给了谁、Message-ID、真实落点（进箱/垃圾箱）</span>
      </div>
      <div class="table-responsive mb-4" style="max-height:22rem;overflow:auto">
        <table class="table table-sm table-hover align-middle mb-0" id="ov_tbl_wumsg">
          <thead class="table-light" style="position:sticky;top:0"><tr>
            <th style="width:15%">发送时间</th><th style="width:20%">发件邮箱</th>
            <th style="width:20%">收件账号</th><th style="width:11%">落点</th>
            <th style="width:11%">已回复</th><th style="width:23%">Message-ID</th></tr></thead>
          <tbody id="ov_wu_msg_body">
              <tr><td colspan="6" class="text-center text-muted py-3">正在加载逐封明细…</td></tr>
            </tbody>
        </table>
      </div>

      <!-- 按天汇总日志 -->
      <div class="d-flex align-items-center gap-2 mb-2">
        <span class="fs-6">按天汇总</span>
      </div>
      <div class="table-responsive" style="max-height:18rem;overflow:auto">
        <table class="table table-sm table-hover align-middle mb-0" id="ov_tbl_wulog">
          <thead class="table-light" style="position:sticky;top:0"><tr>
            <th style="width:17%">时间</th><th style="width:22%">发件邮箱</th>
            <th style="width:9%">计划</th><th style="width:9%">实发</th><th style="width:9%">失败</th>
            <th style="width:34%">详情</th></tr></thead>
          <tbody id="ov_wu_log_body">
              <tr><td colspan="6" class="text-center text-muted py-3">正在加载汇总…</td></tr>
            </tbody>
        </table>
      </div>

    </div>
  </div>

  <!-- ========== 一键添加 ========== -->
  <div class="row g-3 mb-3">
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-header">一键添加域名</div>
        <div class="card-body">
          <div class="mb-2">
            <label class="form-label mb-0 small">域名</label>
            <input type="text" class="form-control form-control-sm" id="ov_new_domain" placeholder="example.com">
          </div>
          <div class="mb-2">
            <label class="form-label mb-0 small">备注（可选）</label>
            <input type="text" class="form-control form-control-sm" id="ov_new_domain_desc">
          </div>
          <div class="row g-2 mb-2">
            <div class="col-4">
              <label class="form-label mb-0 small">关联邮箱数上限</label>
              <input type="number" class="form-control form-control-sm" id="ov_new_domain_mboxes" value="10" min="0">
            </div>
            <div class="col-4">
              <label class="form-label mb-0 small">单邮箱配额(MB)</label>
              <input type="number" class="form-control form-control-sm" id="ov_new_domain_defquota" value="3072" min="1">
            </div>
            <div class="col-4">
              <label class="form-label mb-0 small">域总配额(MB)</label>
              <input type="number" class="form-control form-control-sm" id="ov_new_domain_quota" value="10240" min="1">
            </div>
          </div>
          <button class="btn btn-sm btn-primary" id="ov_add_domain">添加域名</button>
          <div class="form-text">
            添加后自动生成 DKIM 密钥（2048bit），到「配置 → DKIM 密钥」复制 TXT 发布到 DNS。
            <br>配额需满足 <code>单邮箱 ≤ 域总配额</code>，默认值对齐已有域名。
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card h-100">
        <div class="card-header">一键添加邮箱</div>
        <div class="card-body">
          <div class="mb-2">
            <label class="form-label mb-0 small">邮箱地址</label>
            <input type="text" class="form-control form-control-sm" id="ov_new_mbox" placeholder="user@example.com">
          </div>
          <div class="row g-2 mb-2">
            <div class="col-7">
              <label class="form-label mb-0 small">密码</label>
              <input type="text" class="form-control form-control-sm" id="ov_new_mbox_pw" placeholder="留空则自动生成">
            </div>
            <div class="col-5 d-flex align-items-end">
              <button class="btn btn-sm btn-outline-secondary w-100" id="ov_gen_pw">生成随机</button>
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label mb-0 small">配额（MB，0 = 不限）</label>
            <input type="number" class="form-control form-control-sm" id="ov_new_mbox_quota" value="0" min="0">
          </div>
          <button class="btn btn-sm btn-primary" id="ov_add_mbox">添加邮箱</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== 操作日志 ========== -->
  <div class="card mb-4">
    <div class="card-header d-flex align-items-center gap-2">
      <span class="fs-5">操作日志（审计）</span>
      <span class="text-muted small">谁 / 何时 / 对什么 / 做了什么 / 结果</span>
      <div class="ms-auto">
        <button class="btn btn-sm btn-secondary" id="ov_refresh_audit">刷新</button>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive" style="max-height:22rem;overflow:auto">
        <table id="ov_tbl_audit" class="table table-sm table-hover mb-0 align-middle">
          <thead class="table-light" style="position:sticky;top:0">
            <tr>
              <th style="width:18%">时间</th>
              <th style="width:16%">操作者</th>
              <th style="width:18%">动作</th>
              <th style="width:22%">对象</th>
              <th style="width:8%">结果</th>
              <th style="width:18%">详情</th>
            </tr>
          </thead>
          <tbody id="ov_audit_body">
              <tr><td colspan="6" class="text-center text-muted py-3">正在加载审计记录…</td></tr>
            </tbody>
        </table>
      </div>
    </div>
  </div>

</div>
{% endblock %}
